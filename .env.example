# Copy to .env. Everything is optional: with no keys MNEMO runs fully offline
# (in-memory store, heuristic extractor, template explanations).

# MongoDB (Atlas free tier or local). Omit to use the in-memory store.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=mnemo
# auto = mongo when MONGODB_URI is set, otherwise memory
STORE_BACKEND=auto

# Groq (OpenAI-compatible API) powers the live extractor, explainer and QA agent.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
